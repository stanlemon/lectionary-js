{
  "name": "@stanlemon/lectionary",
  "version": "2.0.102",
  "description": "A calculator for the Western Christian church calendar.",
  "keywords": [
    "christian",
    "lectionary",
    "liturgy",
    "lutheran",
    "lutheranism"
  ],
  "author": "Stan Lemon <stanlemon@users.github.com>",
  "license": "MIT",
  "packageManager": "pnpm@12.10.1",
  "repository": {
    "type": "git",
    "url": "git@github.com:stanlemon/lectionary-js.git"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:format": "biome check --write ."
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    }
  },
  "types": "./dist/lib/index.d.ts",
  "dependencies": {
    "dayjs": "^1.11.23",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "25.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
